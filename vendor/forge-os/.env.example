FORGEOS_PORT=8787
HOST=127.0.0.1
FORGEOS_DATA_DIR=.forgeos-data
FORGEOS_STORAGE_BACKEND=sqlite
FORGEOS_ALLOWED_ORIGINS=http://127.0.0.1:8787
# Prefer a mounted secret in production. The entrypoint reads and trims this file.
# FORGEOS_API_KEY_FILE=/run/secrets/forgeos_api_key
# Direct environment secrets are supported for service accounts but are less desirable.
# FORGEOS_API_KEY=replace-with-a-long-random-secret
# Optional OIDC configuration. When enabled, issuer, audience, and JWKS must all be set.
# FORGEOS_OIDC_ISSUER=https://identity.example.com/
# FORGEOS_OIDC_AUDIENCE=forgeos
# FORGEOS_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# External policy decision point. ForgeOS fails closed when configured and unavailable.
# FORGEOS_PDP_URL=https://policy.example.com/v1/data/forgeos/allow
