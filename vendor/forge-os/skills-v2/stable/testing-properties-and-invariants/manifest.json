  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Extract invariants from domain and acceptance contracts.",
        "evidence": "property catalog"
      },
      {
        "id": "step-2",
        "action": "Define generators that cover valid, invalid, boundary, and structurally diverse values.",
        "evidence": "generator definitions"
      },
      {
        "id": "step-3",
        "action": "Use shrinking to minimize failing cases and persist seeds.",
        "evidence": "seed corpus"
      },
      {
        "id": "step-4",
        "action": "Test invariants across round trips, permutations, retries, and state transitions.",
        "evidence": "minimized regressions"
      },
      {
        "id": "step-5",
        "action": "Convert every discovered counterexample into a deterministic regression fixture.",
        "evidence": "minimized regressions"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Is the property stronger than a handful of examples?",
      "Can the generator reach boundary structures?",
      "Is non-determinism seeded and reproducible?",
      "Does shrinking preserve the failure cause?"
