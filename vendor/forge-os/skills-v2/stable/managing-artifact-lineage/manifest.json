    "steps": [
      {
        "id": "step-1",
        "action": "Assign stable project-scoped IDs and canonical content hashes.",
        "evidence": "lineage graph"
      },
      {
        "id": "step-2",
        "action": "Record producing skill, agent identity, consumed artifacts, decisions, evidence, and residual risks.",
        "evidence": "hash manifest"
      },
      {
        "id": "step-3",
        "action": "Append new versions; never mutate previously verified content in place.",
        "evidence": "invalidation report"
      },
      {
        "id": "step-4",
        "action": "When upstream content changes, compute descendants and mark only affected artifacts invalidated.",
        "evidence": "verification record"
      },
      {
        "id": "step-5",
        "action": "Require independent verification before changing state to verified.",
        "evidence": "verification record"
      }
    ],
