  "identity": {
    "title": "Writing Minimal Sufficient Code",
    "description": "Use when minimize code, dependencies, layers, and state while fully satisfying contracts, risks, and operability, especially when does every public abstraction have at least one real consumer?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "implementation"
    ],
