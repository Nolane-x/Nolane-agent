  "contract": {
    "consumes": [
      {
        "type": "execution-plan",
        "schema": "artifact://forgeos/execution-plan/v1"
      },
      {
        "type": "acceptance-contracts",
        "schema": "artifact://forgeos/acceptance-contracts/v1"
      }
    ],
    "produces": [
      {
        "type": "implemented-increment",
        "schema": "artifact://forgeos/implemented-increment/v1"
      }
    ],
    "invariants": [
      "Output remains within the writing-minimal-sufficient-code responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [
      "filesystem",
      "shell"
    ],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "List required behaviors, quality attributes, and extension points that have current consumers.",
        "evidence": "complexity budget"
      },
      {
        "id": "step-2",
        "action": "Choose the fewest concepts that make invalid states hard to represent.",
        "evidence": "deleted-code diff"
      },
      {
        "id": "step-3",
        "action": "Delete duplicate paths, speculative flags, pass-through layers, and narration-shaped abstractions.",
        "evidence": "behavior regression report"
      },
      {
        "id": "step-4",
        "action": "Measure complexity through public surface, branches, state transitions, dependencies, and change amplification—not line count alone.",
        "evidence": "behavior regression report"
      },
      {
        "id": "step-5",
        "action": "Verify behavior and readability after simplification.",
        "evidence": "behavior regression report"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Does every public abstraction have at least one real consumer?",
      "Can a layer be removed without losing a contract or boundary?",
      "Is configuration replacing a missing product decision?",
      "Did simplification preserve tests, observability, and security?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
