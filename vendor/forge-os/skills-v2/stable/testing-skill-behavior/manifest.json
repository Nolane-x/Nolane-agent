  "contract": {
    "consumes": [
      {
        "type": "behavioral-baseline",
        "schema": "artifact://forgeos/behavioral-baseline/v1"
      },
      {
        "type": "candidate-change",
        "schema": "artifact://forgeos/candidate-change/v1"
      }
    ],
    "produces": [
      {
        "type": "skill-evaluation",
        "schema": "artifact://forgeos/skill-evaluation/v1"
      }
    ],
    "invariants": [
      "Output remains within the testing-skill-behavior responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Create a baseline scenario that exposes the target failure without the skill.",
        "evidence": "baseline transcripts"
      },
      {
        "id": "step-2",
        "action": "Record the agent’s exact choices, omissions, and rationalizations.",
        "evidence": "candidate transcripts"
      },
      {
        "id": "step-3",
        "action": "Add the smallest skill guidance that targets the observed failure form.",
        "evidence": "scored comparison"
      },
      {
        "id": "step-4",
        "action": "Repeat across task variations, pressure combinations, models, and context sizes.",
        "evidence": "rationalization catalog"
      },
      {
        "id": "step-5",
        "action": "Measure compliance, output quality, task success, token cost, and new failure modes before promotion.",
        "evidence": "rationalization catalog"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Was a failing baseline observed?",
      "Does the skill improve behavior beyond one prompt seed?",
      "Does it create a new regression or context burden?",
      "Can an agent recognize when the skill should not apply?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
