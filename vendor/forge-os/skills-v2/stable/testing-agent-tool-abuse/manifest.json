    "steps": [
      {
        "id": "step-1",
        "action": "Enumerate tools, permissions, side effects, irreversible actions, and authority delegation paths.",
        "evidence": "abuse-case suite"
      },
      {
        "id": "step-2",
        "action": "Construct indirect prompt injection, tool argument manipulation, cross-context, replay, and confused-deputy scenarios.",
        "evidence": "tool permission matrix"
      },
      {
        "id": "step-3",
        "action": "Verify server-side schema, authorization, scope, idempotency, and human confirmation independently of model compliance.",
        "evidence": "blocked exploit traces"
      },
      {
        "id": "step-4",
        "action": "Test least-privilege degradation when a tool or model is compromised.",
        "evidence": "residual-risk report"
      },
      {
        "id": "step-5",
        "action": "Record exploit traces without exposing live credentials or harming external systems.",
        "evidence": "residual-risk report"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
