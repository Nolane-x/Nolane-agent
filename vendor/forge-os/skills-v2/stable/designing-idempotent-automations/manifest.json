  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Identify the business operation and define its idempotency boundary.",
        "evidence": "idempotency contract"
      },
      {
        "id": "step-2",
        "action": "Choose stable keys from event identity and operation scope; define retention and collision behavior.",
        "evidence": "state machine"
      },
      {
        "id": "step-3",
        "action": "Persist claim, progress, result, and terminal failure atomically with side-effect ordering.",
        "evidence": "concurrency tests"
      },
      {
        "id": "step-4",
        "action": "Handle concurrent claims, partial external success, provider timeouts, and replay.",
        "evidence": "reconciliation runbook"
      },
      {
        "id": "step-5",
        "action": "Expose operator-safe retry, reconciliation, and audit evidence.",
        "evidence": "reconciliation runbook"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
