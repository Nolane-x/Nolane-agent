  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Decompose each product claim into the evidence it actually requires.",
        "evidence": "source ledger"
      },
      {
        "id": "step-2",
        "action": "Prefer primary and authoritative sources; record when only secondary evidence exists.",
        "evidence": "claim-to-source matrix"
      },
      {
        "id": "step-3",
        "action": "Check publication date, version, scope, methodology, and incentives.",
        "evidence": "freshness record"
      },
      {
        "id": "step-4",
        "action": "Corroborate load-bearing claims through independent sources where possible.",
        "evidence": "confidence notes"
      },
      {
        "id": "step-5",
        "action": "Attach confidence and limitations to each claim, not only to the document.",
        "evidence": "confidence notes"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Does the source support the exact claim being made?",
      "Could the fact have changed since publication?",
      "Are disagreements represented rather than averaged away?",
      "Is an inference labeled as an inference?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
