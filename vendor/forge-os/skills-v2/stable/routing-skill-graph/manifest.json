      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Build an eligibility set from contract preconditions before scoring.",
        "evidence": "eligibility matrix"
      },
      {
        "id": "step-2",
        "action": "Score state match, artifact need, domain fit, assurance fit, available tools, measured utility, and context cost separately.",
        "evidence": "ranked route"
      },
      {
        "id": "step-3",
        "action": "Apply hard exclusions before soft ranking.",
        "evidence": "exclusion reasons"
      },
      {
        "id": "step-4",
        "action": "Resolve conflicts by preferring the route that satisfies the gate with fewer assumptions and less context.",
        "evidence": "context estimate"
      },
      {
        "id": "step-5",
        "action": "Persist route reasons so the same state produces deterministic ordering.",
        "evidence": "context estimate"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
