  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "State the product thesis and riskiest causal assumption.",
        "evidence": "MVP capability map"
      },
      {
        "id": "step-2",
        "action": "Map the single critical user journey that can falsify the thesis.",
        "evidence": "critical journey"
      },
      {
        "id": "step-3",
        "action": "Include only capabilities required to complete and measure that journey.",
        "evidence": "non-goal list"
      },
      {
        "id": "step-4",
        "action": "Define operational, security, accessibility, and recovery minimums that cannot be deferred.",
        "evidence": "experiment plan"
      },
      {
        "id": "step-5",
        "action": "Move every other capability to a later hypothesis with an explicit trigger for reconsideration.",
        "evidence": "experiment plan"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Does the MVP deliver user value end to end?",
      "Can it test the riskiest assumption?",
      "Are reliability and security basics treated as scope, not polish?",
      "Can every included feature name the thesis dependency it serves?"
