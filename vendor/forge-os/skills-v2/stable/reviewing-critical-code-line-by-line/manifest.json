  "id": "reviewing-critical-code-line-by-line",
  "version": "1.0.0",
  "skillType": "technique",
  "maturity": "stable",
  "identity": {
    "title": "Reviewing Critical Code Line By Line",
    "description": "Use when review high-impact code with complete data-flow, control-flow, failure, concurrency, and trust-boundary coverage, especially when can malformed, stale, duplicated, reordered, or unauthorized input reach a side effect?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "implementation"
    ],
    "keywords": [
      "reviewing-critical-code-line-by-line",
      "review",
      "high",
      "impact",
      "code",
      "with",
      "complete",
      "data",
      "flow"
    ],
    "antiTriggers": [
      "generated lockfiles with no manual logic",
      "broad architectural review without critical code paths"
    ]
  },
  "relations": {
    "requires": [
      "implemented-increment"
    ],
    "specializes": [],
    "composedWith": [],
    "conflictsWith": [],
    "alternativesTo": [],
    "supersedes": []
  },
  "contract": {
    "consumes": [
      {
        "type": "implemented-increment",
        "schema": "artifact://forgeos/implemented-increment/v1"
      }
    ],
    "produces": [
      {
        "type": "verified-build",
        "schema": "artifact://forgeos/verified-build/v1"
      }
    ],
    "invariants": [
      "Output remains within the reviewing-critical-code-line-by-line responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [
      "filesystem",
      "shell"
    ],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Define why the module is critical and identify assets, callers, side effects, invariants, and failure consequences.",
        "evidence": "annotated diff"
      },
      {
        "id": "step-2",
        "action": "Trace every input from origin through validation, transformation, authorization, persistence, and output.",
        "evidence": "data-flow map"
      },
      {
        "id": "step-3",
        "action": "Review each branch, error path, cleanup path, retry, timeout, and concurrent interleaving.",
        "evidence": "finding ledger"
      },
      {
        "id": "step-4",
        "action": "Cross-check code against requirements, tests, dependency behavior, and operational telemetry.",
        "evidence": "closure evidence"
      },
      {
        "id": "step-5",
        "action": "Record findings with exact lines, exploit or failure scenario, severity, and required evidence for closure.",
        "evidence": "closure evidence"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can malformed, stale, duplicated, reordered, or unauthorized input reach a side effect?",
      "Can partial failure leave durable corruption or cost?",
      "Do tests kill plausible mutations in critical branches?",
      "Can logs or errors disclose secrets?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "annotated diff",
      "data-flow map",
      "finding ledger",
      "closure evidence"
    ],
    "evaluatorIds": [
      "reviewing-critical-code-line-by-line-evaluator"
    ]
  },
