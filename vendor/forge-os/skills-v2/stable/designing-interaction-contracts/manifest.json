  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Enumerate user intents and system states for each critical interaction.",
        "evidence": "interaction state table"
      },
      {
        "id": "step-2",
        "action": "Define input constraints, feedback, optimistic behavior, loading, empty, partial, error, permission, and recovery states.",
        "evidence": "accessibility contract"
      },
      {
        "id": "step-3",
        "action": "Specify keyboard, screen-reader, focus, motion, and responsive behavior.",
        "evidence": "acceptance scenarios"
      },
      {
        "id": "step-4",
        "action": "Map each visible state to backend contracts and telemetry.",
        "evidence": "backend mapping"
      },
      {
        "id": "step-5",
        "action": "Create executable acceptance scenarios before visual polish.",
        "evidence": "backend mapping"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Is every asynchronous action observable and recoverable?",
      "Can a keyboard-only user complete the critical flow?",
      "Do frontend states correspond to real backend outcomes?",
      "Are destructive actions reversible or explicitly confirmed?"
