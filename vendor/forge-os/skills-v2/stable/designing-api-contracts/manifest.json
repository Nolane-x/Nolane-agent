        "type": "architecture-decision",
        "schema": "artifact://forgeos/architecture-decision/v1"
      }
    ],
    "invariants": [
      "Output remains within the designing-api-contracts responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Map API operations to user and domain capabilities rather than database tables.",
        "evidence": "API specification"
      },
      {
        "id": "step-2",
        "action": "Define schemas, constraints, examples, errors, side effects, authorization, and idempotency semantics.",
        "evidence": "contract tests"
      },
      {
        "id": "step-3",
        "action": "Specify pagination, filtering, concurrency control, rate limits, retries, and backward compatibility.",
        "evidence": "error catalog"
      },
      {
        "id": "step-4",
        "action": "Generate consumer and provider contract tests from the same specification.",
        "evidence": "compatibility report"
      },
      {
        "id": "step-5",
        "action": "Review sensitive fields, tenant boundaries, and logging behavior before implementation.",
        "evidence": "compatibility report"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can a client recover from every documented error?",
      "Are retries safe and duplicate requests defined?",
      "Does authorization apply to each object and action?",
      "Can an old client continue after a compatible server change?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "API specification",
      "contract tests",
      "error catalog",
      "compatibility report"
