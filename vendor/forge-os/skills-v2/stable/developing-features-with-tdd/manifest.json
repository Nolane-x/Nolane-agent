  "version": "1.0.0",
  "skillType": "technique",
  "maturity": "stable",
  "identity": {
    "title": "Developing Features With Tdd",
    "description": "Use when implement one externally observable feature through a verified red-green-refactor cycle, especially when was the failure observed before implementation?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "implementation"
    ],
    "keywords": [
      "developing-features-with-tdd",
      "implement",
      "one",
      "externally",
      "observable",
      "feature",
      "through",
      "a",
      "verified"
    ],
    "antiTriggers": [
      "generated fixtures or disposable experiments",
      "documentation-only changes with no executable behavior"
    ]
  },
  "relations": {
    "requires": [
      "execution-plan",
      "acceptance-contracts"
    ],
    "specializes": [],
    "composedWith": [],
    "conflictsWith": [],
    "alternativesTo": [],
    "supersedes": []
  },
  "contract": {
    "consumes": [
      {
        "type": "execution-plan",
        "schema": "artifact://forgeos/execution-plan/v1"
      },
      {
        "type": "acceptance-contracts",
        "schema": "artifact://forgeos/acceptance-contracts/v1"
      }
    ],
    "produces": [
      {
        "type": "implemented-increment",
        "schema": "artifact://forgeos/implemented-increment/v1"
      }
    ],
    "invariants": [
      "Output remains within the developing-features-with-tdd responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [
      "filesystem",
      "shell"
    ],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Write the smallest behavior test from the acceptance contract before production code.",
        "evidence": "red test log"
      },
      {
        "id": "step-2",
        "action": "Run it and confirm it fails for the intended missing behavior rather than setup or syntax.",
        "evidence": "green test log"
      },
      {
        "id": "step-3",
        "action": "Implement only enough behavior to pass, then run the focused and relevant regression suites.",
        "evidence": "diff review"
      },
      {
        "id": "step-4",
        "action": "Refactor only while all tests remain green and no behavior changes.",
        "evidence": "commit hash"
      },
      {
        "id": "step-5",
        "action": "Record the red output, green output, diff review, and remaining risks.",
        "evidence": "commit hash"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Was the failure observed before implementation?",
      "Does the test assert behavior rather than mocks or internals?",
      "Did implementation add anything not demanded by the test?",
      "Are warnings and unrelated regressions zero?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "red test log",
      "green test log",
      "diff review",
      "commit hash"
    ],
    "evaluatorIds": [
      "developing-features-with-tdd-evaluator"
    ]
  },
