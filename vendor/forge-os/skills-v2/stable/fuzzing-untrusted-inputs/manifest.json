  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Inventory every decoder and externally controlled byte or value boundary.",
        "evidence": "seed corpus"
      },
      {
        "id": "step-2",
        "action": "Build seed corpora from valid examples, historical failures, boundary values, and protocol dictionaries.",
        "evidence": "fuzz configuration"
      },
      {
        "id": "step-3",
        "action": "Define crash, timeout, memory, invariant, authorization, and differential oracles.",
        "evidence": "crash or hang artifacts"
      },
      {
        "id": "step-4",
        "action": "Run mutation or grammar-based fuzzing under bounded resources and capture exact seeds.",
        "evidence": "minimized regression cases"
      },
      {
        "id": "step-5",
        "action": "Minimize failures, classify reachability and impact, then promote them to regression fixtures.",
        "evidence": "minimized regression cases"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Does the fuzzer reach deep parser states?",
      "Are hangs and resource exhaustion treated as failures?",
      "Can the same seed reproduce the issue?",
      "Are sensitive production systems excluded from unsafe fuzzing?"
