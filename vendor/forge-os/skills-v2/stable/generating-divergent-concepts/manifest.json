      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Freeze the creative brief, forbidden defaults, resource limits, and evaluation frame.",
        "evidence": "idea genomes"
      },
      {
        "id": "step-2",
        "action": "Dispatch independent lenses that cannot see one another’s candidates during the first pass.",
        "evidence": "lens provenance"
      },
      {
        "id": "step-3",
        "action": "Require each candidate to specify user, hidden problem, trigger, mechanism, interface, incentive, distribution, assumptions, and cheapest experiment.",
        "evidence": "semantic clusters"
      },
      {
        "id": "step-4",
        "action": "Force a second pass through inversion, removal, extreme constraints, and cross-domain mechanism transfer.",
        "evidence": "forbidden-pattern report"
      },
      {
        "id": "step-5",
        "action": "Cluster by mechanism and regenerate any region represented only by naming or feature variation.",
        "evidence": "forbidden-pattern report"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Do candidates differ in causal mechanism rather than wording?",
      "Did any candidate merely add AI, automation, or gamification?",
      "Were independent branches preserved before synthesis?",
      "Can every candidate be falsified cheaply?"
