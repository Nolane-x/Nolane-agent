  "version": "1.0.0",
  "skillType": "technique",
  "maturity": "stable",
  "identity": {
    "title": "Resolving User Intent",
    "description": "Use when convert ambiguous product language into explicit goals, users, constraints, non-goals, success measures, and decision ownership, especially when could two competent teams build materially different products from this intent?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "kernel"
    ],
    "keywords": [
      "resolving-user-intent",
      "convert",
      "ambiguous",
      "product",
      "language",
      "into",
      "explicit",
      "goals",
      "users"
    ],
    "antiTriggers": [
      "a fully specified deterministic command",
      "minor wording preferences that do not affect behavior"
    ]
  },
  "relations": {
    "requires": [
      "project-state",
      "gate-state"
    ],
    "specializes": [],
    "composedWith": [],
    "conflictsWith": [],
    "alternativesTo": [],
    "supersedes": []
  },
  "contract": {
    "consumes": [
      {
        "type": "project-state",
        "schema": "artifact://forgeos/project-state/v1"
      },
      {
        "type": "gate-state",
        "schema": "artifact://forgeos/gate-state/v1"
      }
    ],
    "produces": [
      {
        "type": "routing-decision",
        "schema": "artifact://forgeos/routing-decision/v1"
      }
    ],
    "invariants": [
      "Output remains within the resolving-user-intent responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Separate stated facts from model interpretations and unresolved questions.",
        "evidence": "confirmed-intent artifact"
      },
      {
        "id": "step-2",
        "action": "Classify missing information by materiality: blocking, important, or safely deferrable.",
        "evidence": "open-question ledger"
      },
      {
        "id": "step-3",
        "action": "Ask one decision-sized question at a time and prefer bounded choices when they preserve intent.",
        "evidence": "decision log"
      },
      {
        "id": "step-4",
        "action": "Reflect the answer back as a change to the intent artifact rather than as chat memory.",
        "evidence": "decision log"
      },
      {
        "id": "step-5",
        "action": "Request explicit confirmation only after contradictions and hidden assumptions are exposed.",
        "evidence": "decision log"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Could two competent teams build materially different products from this intent?",
      "Is each success measure observable?",
      "Are constraints distinguished from preferences?",
      "Has the user confirmed every decision that changes scope, risk, cost, or irreversibility?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "confirmed-intent artifact",
      "open-question ledger",
      "decision log"
    ],
    "evaluatorIds": [
      "resolving-user-intent-evaluator"
    ]
  },
