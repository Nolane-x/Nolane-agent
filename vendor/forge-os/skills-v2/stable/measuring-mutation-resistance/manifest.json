    "steps": [
      {
        "id": "step-1",
        "action": "Select mutation operators that represent realistic defects for the language and domain.",
        "evidence": "mutation report"
      },
      {
        "id": "step-2",
        "action": "Exclude generated, unreachable, and non-behavioral code with recorded reasons.",
        "evidence": "critical-survivor list"
      },
      {
        "id": "step-3",
        "action": "Run mutations against focused suites and classify killed, survived, timed out, and uncovered mutants.",
        "evidence": "new regression tests"
      },
      {
        "id": "step-4",
        "action": "Review surviving mutants in critical logic before using a global score.",
        "evidence": "exclusion rationale"
      },
      {
        "id": "step-5",
        "action": "Add behavior tests that kill meaningful survivors without asserting implementation details.",
        "evidence": "exclusion rationale"
      }
    ],
