    "supersedes": []
  },
  "contract": {
    "consumes": [
      {
        "type": "architecture-decision",
        "schema": "artifact://forgeos/architecture-decision/v1"
      },
      {
        "type": "threat-model",
        "schema": "artifact://forgeos/threat-model/v1"
      }
    ],
    "produces": [
      {
        "type": "execution-plan",
        "schema": "artifact://forgeos/execution-plan/v1"
      },
      {
        "type": "acceptance-contracts",
        "schema": "artifact://forgeos/acceptance-contracts/v1"
      }
    ],
    "invariants": [
      "Output remains within the writing-executable-plans responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Map verified requirements and acceptance contracts to concrete files, interfaces, migrations, and tests.",
        "evidence": "implementation plan"
      },
      {
        "id": "step-2",
        "action": "Split work where a reviewer could approve one deliverable and reject the next.",
        "evidence": "requirement-to-task matrix"
      },
      {
        "id": "step-3",
        "action": "For each task, write a failing test, expected failure, minimal implementation, focused verification, regression command, and commit boundary.",
        "evidence": "dependency DAG"
      },
      {
        "id": "step-4",
        "action": "Declare exact consumed and produced interfaces so tasks can be executed out of conversational order.",
        "evidence": "plan self-review"
      },
      {
        "id": "step-5",
        "action": "Run a coverage review against the specification and remove placeholders, speculative work, and inconsistent names.",
        "evidence": "plan self-review"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can an agent with no prior chat execute each task?",
      "Does every requirement map to a task and acceptance test?",
      "Does every task end in an independently testable artifact?",
      "Are exact paths, signatures, commands, and expected outputs present?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "implementation plan",
      "requirement-to-task matrix",
      "dependency DAG",
      "plan self-review"
    ],
