  "identity": {
    "title": "Writing Executable Plans",
    "description": "Use when produce a dependency-aware sequence of vertical increments that a fresh agent can execute and independently verify, especially when can an agent with no prior chat execute each task?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "planning"
    ],
    "keywords": [
      "writing-executable-plans",
      "produce",
      "a",
      "dependency",
      "aware",
      "sequence",
      "of",
      "vertical",
      "increments"
    ],
    "antiTriggers": [
      "a one-step reversible edit",
      "work whose requirements are still materially ambiguous"
    ]
  },
  "relations": {
    "requires": [
      "architecture-decision",
      "threat-model"
    ],
    "specializes": [],
    "composedWith": [],
    "conflictsWith": [],
