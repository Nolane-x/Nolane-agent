  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Choose tenancy model from isolation, cost, scale, compliance, and migration requirements.",
        "evidence": "tenancy decision"
      },
      {
        "id": "step-2",
        "action": "Define tenant context propagation through authentication, authorization, storage, queues, caches, logs, and background jobs.",
        "evidence": "tenant data map"
      },
      {
        "id": "step-3",
        "action": "Make every tenant-scoped query and side effect structurally require tenant identity.",
        "evidence": "isolation test suite"
      },
      {
        "id": "step-4",
        "action": "Plan provisioning, suspension, deletion, export, backup, restore, and tenant migration.",
        "evidence": "lifecycle runbook"
      },
      {
        "id": "step-5",
        "action": "Create cross-tenant negative tests and operational detection signals.",
        "evidence": "lifecycle runbook"
      }
    ],
