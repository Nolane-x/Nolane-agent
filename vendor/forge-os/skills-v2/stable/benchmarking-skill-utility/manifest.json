  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Define representative cases, success criteria, judge rubric, models, seeds, and token budgets before running.",
        "evidence": "eval corpus"
      },
      {
        "id": "step-2",
        "action": "Run baseline and candidate conditions with identical task inputs and tool availability.",
        "evidence": "run manifest"
      },
      {
        "id": "step-3",
        "action": "Blind judges to condition where possible and separate task success from style preference.",
        "evidence": "paired results"
      },
      {
        "id": "step-4",
        "action": "Calculate pass-rate, quality, critical failures, token growth, latency, and variance.",
        "evidence": "promotion decision"
      },
      {
        "id": "step-5",
        "action": "Promote only measurable gains; quarantine regressions and token-only growth.",
        "evidence": "promotion decision"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
