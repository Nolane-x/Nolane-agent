  "identity": {
    "title": "Using Forge Os",
    "description": "Use when route one project from confirmed intent to the next evidence-backed state without loading unrelated skills, especially when can every selected skill name a missing gate artifact?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "kernel"
    ],
