      "to",
      "the"
    ],
    "antiTriggers": [
      "a simple factual question with no product workflow",
      "an existing non-ForgeOS workflow the user did not ask to migrate"
    ]
  },
  "relations": {
    "requires": [
      "project-state",
      "gate-state"
    ],
    "specializes": [],
    "composedWith": [],
    "conflictsWith": [],
    "alternativesTo": [],
    "supersedes": []
  },
  "contract": {
    "consumes": [
      {
        "type": "project-state",
        "schema": "artifact://forgeos/project-state/v1"
      },
      {
        "type": "gate-state",
        "schema": "artifact://forgeos/gate-state/v1"
      }
    ],
    "produces": [
      {
        "type": "routing-decision",
        "schema": "artifact://forgeos/routing-decision/v1"
      }
    ],
    "invariants": [
      "Output remains within the using-forge-os responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Read only the project header, current gate, open findings, direct artifact hashes, and confirmed decisions.",
        "evidence": "route-decision.json"
      },
      {
        "id": "step-2",
        "action": "Compute missing gate artifacts before selecting any skill.",
        "evidence": "context-pack manifest"
      },
      {
        "id": "step-3",
        "action": "Exclude skills with failed preconditions, unavailable tools, conflicts, quarantine status, or assurance mismatch.",
        "evidence": "current gate snapshot"
      },
      {
        "id": "step-4",
        "action": "Activate the smallest non-conflicting skill set that can close the current evidence gap.",
        "evidence": "current gate snapshot"
      },
      {
        "id": "step-5",
        "action": "Commit the route explanation, context budget, stop condition, and invalidation impact before dispatch.",
        "evidence": "current gate snapshot"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can every selected skill name a missing gate artifact?",
      "Would removing any selected skill leave the same gate achievable?",
      "Are human decisions and critical findings represented explicitly?",
      "Does the context pack omit unrelated history and full skill bodies?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
      "route-decision.json",
      "context-pack manifest",
      "current gate snapshot"
    ],
    "evaluatorIds": [
