  "contract": {
    "consumes": [
      {
        "type": "verification-report",
        "schema": "artifact://forgeos/verification-report/v1"
      },
      {
        "type": "security-review",
        "schema": "artifact://forgeos/security-review/v1"
      }
    ],
    "produces": [
      {
        "type": "security-release-decision",
        "schema": "artifact://forgeos/security-release-decision/v1"
      }
    ],
    "invariants": [
      "Output remains within the running-security-release-gate responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Resolve the assurance profile and enumerate mandatory security evidence.",
        "evidence": "security gate result"
      },
      {
        "id": "step-2",
        "action": "Verify every critical and high finding against closure evidence rather than status labels.",
        "evidence": "finding closure matrix"
      },
      {
        "id": "step-3",
        "action": "Check dependency, secret, authorization, tenant, prompt injection, tool abuse, rollback, and incident readiness evidence.",
        "evidence": "release hash manifest"
      },
      {
        "id": "step-4",
        "action": "Reject aggregate scores that hide a critical blocker.",
        "evidence": "residual-risk acceptance"
      },
      {
        "id": "step-5",
        "action": "Emit pass, fail, or blocked with exact rule IDs, remediation, owner, and evidence hashes.",
        "evidence": "residual-risk acceptance"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Are any findings accepted without exact human confirmation?",
      "Do evidence hashes match the release candidate?",
      "Can the build be reproduced and rolled back?",
      "Are monitoring and incident owners ready before exposure?"
    ],
    "reviewerRole": "security-reviewer",
    "independentReview": true,
    "evidenceTypes": [
