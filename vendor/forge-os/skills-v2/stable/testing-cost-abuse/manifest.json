  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Inventory every metered operation and calculate cost per request, retry, fan-out, and retained artifact.",
        "evidence": "cost surface map"
      },
      {
        "id": "step-2",
        "action": "Model attacker budget versus defender cost amplification.",
        "evidence": "amplification calculations"
      },
      {
        "id": "step-3",
        "action": "Exercise burst, replay, concurrency, recursive workflows, oversized context, cache busting, and failed-payment paths.",
        "evidence": "abuse test logs"
      },
      {
        "id": "step-4",
        "action": "Verify quotas, idempotency, backpressure, cancellation, spending caps, and anomaly alerts server-side.",
        "evidence": "cap and alert evidence"
      },
      {
        "id": "step-5",
        "action": "Calculate worst-case daily exposure and require explicit acceptance when it exceeds the product risk budget.",
        "evidence": "cap and alert evidence"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can one cheap request trigger many expensive downstream calls?",
      "Can retries or partial failures double-charge?",
      "Are per-user, per-tenant, and global caps independent?",
      "Does cancellation stop already queued cost?"
    ],
