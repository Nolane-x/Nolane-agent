  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Measure current context by source, reuse, freshness, and decision value.",
        "evidence": "context profile"
      },
      {
        "id": "step-2",
        "action": "Replace repeated structures with stable IDs, hashes, signatures, and deltas.",
        "evidence": "compressed pack"
      },
      {
        "id": "step-3",
        "action": "Separate global metadata, selected skill bodies, direct artifacts, and on-demand references.",
        "evidence": "A/B results"
      },
      {
        "id": "step-4",
        "action": "A/B test compressed and full contexts on task success and critical omissions.",
        "evidence": "omission audit"
      },
      {
        "id": "step-5",
        "action": "Reject savings that reduce correctness, evidence quality, or recovery ability.",
        "evidence": "omission audit"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
