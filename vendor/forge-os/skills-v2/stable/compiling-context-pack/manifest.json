  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Start from declared consumes and traverse only direct dependencies within the reference-depth budget.",
        "evidence": "context manifest"
      },
      {
        "id": "step-2",
        "action": "Represent large project structures through stable IDs, hashes, signatures, and deltas.",
        "evidence": "artifact hashes"
      },
      {
        "id": "step-3",
        "action": "Include unresolved findings and decisions that constrain the output.",
        "evidence": "omission list"
      },
      {
        "id": "step-4",
        "action": "Reject stale artifacts whose hashes no longer match the graph.",
        "evidence": "token estimate"
      },
      {
        "id": "step-5",
        "action": "Emit an explicit omission list so the worker knows what was deliberately excluded.",
        "evidence": "token estimate"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
