      {
        "type": "architecture-decision",
        "schema": "artifact://forgeos/architecture-decision/v1"
      }
    ],
    "invariants": [
      "Output remains within the choosing-system-architecture responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Translate product capabilities into measurable quality attributes and workload assumptions.",
        "evidence": "architecture decision record"
      },
      {
        "id": "step-2",
        "action": "Model at least two viable architectures with boundaries, data ownership, failure propagation, deployment, and cost.",
        "evidence": "quality-attribute scenarios"
      },
      {
        "id": "step-3",
        "action": "Use decision drivers and disqualifiers rather than trend preference.",
        "evidence": "failure map"
      },
      {
        "id": "step-4",
        "action": "Threat-model and operate the leading option on paper, including migration and rollback.",
        "evidence": "validation plan"
      },
      {
        "id": "step-5",
        "action": "Record the decision, rejected alternatives, assumptions, validation experiments, and expiry conditions.",
        "evidence": "validation plan"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Can the architecture be explained through bounded responsibilities?",
      "Is each added component justified by a current quality attribute?",
      "What happens when every dependency is slow, unavailable, or duplicated?",
      "Which future change would force this decision to be revisited?"
    ],
    "reviewerRole": "independent-reviewer",
    "independentReview": true,
    "evidenceTypes": [
