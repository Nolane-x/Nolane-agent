  "identity": {
    "title": "Choosing System Architecture",
    "description": "Use when select the simplest architecture that satisfies quality attributes, failure boundaries, extension needs, and operational constraints, especially when can the architecture be explained through bounded responsibilities?.",
    "domains": [
      "all"
    ],
    "subdomains": [
      "architecture"
