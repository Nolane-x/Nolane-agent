      "Output remains within the constructing-idea-genomes responsibility boundary",
      "Every pass claim is backed by current trusted evidence"
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "intent.confirmed"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Extract target user, hidden problem, trigger, mechanism, interface, resource, incentive, ownership, time model, distribution, value, assumptions, and failure modes.",
        "evidence": "idea-genome artifact"
      },
      {
        "id": "step-2",
        "action": "Normalize each field to one causal statement and remove marketing adjectives.",
        "evidence": "semantic fingerprint"
      },
      {
        "id": "step-3",
        "action": "Mark inherited components versus novel mutations.",
        "evidence": "assumption list"
      },
      {
        "id": "step-4",
        "action": "Generate a semantic fingerprint from mechanism-level fields.",
        "evidence": "assumption list"
      },
      {
        "id": "step-5",
        "action": "Reject incomplete genomes before scoring or recombination.",
        "evidence": "assumption list"
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required tool, input, or approval is unavailable",
        "action": "stop and record a typed blocker"
      }
    ],
    "stopConditions": [
      "Output contract is satisfied, a blocker is recorded, or a material human decision is required."
    ]
  },
  "verification": {
    "executableChecks": [
      "Could another agent reconstruct the same concept from the genome?",
      "Does the mechanism explain how value is created?",
      "Are assumptions independently testable?",
      "Would a title change leave the fingerprint unchanged?"
