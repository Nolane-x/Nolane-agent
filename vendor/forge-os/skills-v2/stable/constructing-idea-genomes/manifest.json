  "contract": {
    "consumes": [
      {
        "type": "creative-brief",
        "schema": "artifact://forgeos/creative-brief/v1"
      }
    ],
    "produces": [
      {
        "type": "candidate-ideas",
        "schema": "artifact://forgeos/candidate-ideas/v1"
