  },
  "procedure": {
    "entryConditions": [
      "confirmed intent and current semantic revision exist"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Resolve active artifact versions and requested dependency depth.",
        "evidence": "Invalidated and superseded artifacts are never projected as active."
      },
      {
        "id": "step-2",
        "action": "Compare content and envelope hashes with the checkpoint.",
        "evidence": "Reference depth is enforced."
      },
      {
        "id": "step-3",
        "action": "Emit changed fields, invalidations, and unchanged references separately.",
        "evidence": "Every delta identifies its source and current hash."
      },
      {
        "id": "step-4",
        "action": "Provide explicit fetch handles for omitted full bodies.",
        "evidence": "Every delta identifies its source and current hash."
      }
    ],
