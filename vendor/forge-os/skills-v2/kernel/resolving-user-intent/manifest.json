      {
        "id": "step-2",
        "action": "Classify unknowns as blocking, material, or safely deferrable.",
        "evidence": "Every success measure is observable."
      },
      {
        "id": "step-3",
        "action": "Ask one decision-sized question and bind the answer to the intent artifact.",
        "evidence": "Scope, non-goals, constraints, and decision owners are explicit."
      },
      {
        "id": "step-4",
        "action": "Stop only when scope-changing assumptions have authenticated ownership.",
        "evidence": "Scope, non-goals, constraints, and decision owners are explicit."
      }
