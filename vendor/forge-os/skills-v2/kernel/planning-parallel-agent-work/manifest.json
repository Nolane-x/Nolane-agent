        "action": "Derive work units from dependency and change graphs.",
        "evidence": "No output target has two active writers."
      },
      {
        "id": "step-2",
        "action": "Assign one owner and output lock per unit.",
        "evidence": "Coverage ledger accounts for every scoped unit."
      },
      {
        "id": "step-3",
        "action": "Define context packs that omit unrelated sibling work.",
        "evidence": "Join failure leaves resumable state."
      },
      {
        "id": "step-4",
        "action": "Join only after every unit has a trusted completion receipt.",
        "evidence": "Join failure leaves resumable state."
