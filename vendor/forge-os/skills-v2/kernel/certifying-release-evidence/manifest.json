    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Freeze the source manifest and all release subjects.",
        "evidence": "Archive can verify without a .git directory."
      },
      {
        "id": "step-2",
        "action": "Run mandatory tests, audits, protocol checks, and archive acceptance independently.",
        "evidence": "Evidence names exact source and archive digests."
      },
      {
        "id": "step-3",
        "action": "Generate SBOM, provenance, checksums, and detached signatures.",
        "evidence": "Private signing material is not packaged."
      },
      {
        "id": "step-4",
        "action": "Publish claims boundaries and residual risks alongside evidence.",
        "evidence": "Private signing material is not packaged."
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required deterministic stage cannot run",
        "action": "stop and emit a typed blocker"
      }
    ],
