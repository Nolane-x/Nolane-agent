    "produces": [
      {
        "type": "lineage-update",
        "schema": "artifact://forgeos/lineage-update/v1"
      }
    ],
    "invariants": [
      "The artifact graph remains acyclic.",
      "Exactly one active version exists per typed slot.",
      "Tampering with lifecycle metadata is detectable."
    ],
    "requiredTools": [],
    "optionalTools": []
  },
  "procedure": {
    "entryConditions": [
      "confirmed intent and current semantic revision exist"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Validate typed dependencies and active version slots before write.",
        "evidence": "The artifact graph remains acyclic."
      },
      {
        "id": "step-2",
        "action": "Record content hash and immutable lifecycle envelope separately.",
        "evidence": "Exactly one active version exists per typed slot."
      },
      {
        "id": "step-3",
        "action": "Maintain supersession links and dependency hashes in both directions.",
        "evidence": "Tampering with lifecycle metadata is detectable."
      },
      {
        "id": "step-4",
        "action": "Invalidate downstream artifacts and proof when an upstream subject changes.",
        "evidence": "Tampering with lifecycle metadata is detectable."
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required deterministic stage cannot run",
        "action": "stop and emit a typed blocker"
      }
    ],
    "stopConditions": [
      "lineage-update is produced with current evidence or a blocker is recorded"
    ]
  },
