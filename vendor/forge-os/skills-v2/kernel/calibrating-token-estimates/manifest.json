        "action": "Record estimated and actual usage with model version and content class.",
        "evidence": "Calibration cannot reduce safety below policy minimum."
      },
      {
        "id": "step-2",
        "action": "Compute absolute and relative error without storing sensitive content.",
        "evidence": "p95 error is reported by model family."
      },
      {
        "id": "step-3",
        "action": "Update bounded calibration factors using recent weighted observations.",
        "evidence": "Old model versions do not calibrate new versions silently."
      },
      {
        "id": "step-4",
        "action": "Increase safety margin when uncertainty or model drift rises.",
        "evidence": "Old model versions do not calibrate new versions silently."
