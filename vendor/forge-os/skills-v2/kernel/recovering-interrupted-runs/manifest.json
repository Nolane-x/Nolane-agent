  "procedure": {
    "entryConditions": [
      "confirmed intent and current semantic revision exist"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "Load the last committed state, lease, coverage, and output locks.",
        "evidence": "Old workers cannot complete after reclamation."
      },
      {
        "id": "step-2",
        "action": "Reclaim only expired work using a higher fencing sequence.",
        "evidence": "Completed side effects are not repeated."
      },
      {
        "id": "step-3",
        "action": "Verify completed receipts and identify uncommitted side effects.",
        "evidence": "Recovery itself has an audit receipt."
      },
      {
        "id": "step-4",
        "action": "Resume the minimal remaining units with idempotency keys.",
        "evidence": "Recovery itself has an audit receipt."
      }
    ],
    "fallbackPaths": [
      {
        "condition": "required deterministic stage cannot run",
        "action": "stop and emit a typed blocker"
      }
    ],
