        "id": "step-1",
        "action": "Store raw bytes in content-addressed evidence storage.",
        "evidence": "Failure-causing ranges remain in the summary."
      },
      {
        "id": "step-2",
        "action": "Classify output type and locate failures, warnings, stacks, and relevant ranges.",
        "evidence": "Raw output hash is verifiable."
      },
      {
        "id": "step-3",
        "action": "Create a bounded summary with command, status, duration, and omission notes.",
        "evidence": "Secrets are redacted before model delivery."
      },
      {
        "id": "step-4",
        "action": "Bind the summary to the raw digest and retrieval URI.",
        "evidence": "Secrets are redacted before model delivery."
      }
    ],
