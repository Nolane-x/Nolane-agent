{
  "name": "forge-os",
  "version": "0.6.1",
  "description": "Deterministic Skill Intelligence OS for trusted AI agents: 128 kernel techniques, hybrid execution graphs, globally budgeted context, continuous learning quarantine, harness-native rules/hooks, and evidence-backed delivery.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:skills": "node scripts/generate-skills.mjs && node scripts/harden-skill-graph.mjs",
    "start": "node src/server/http-server.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-force-exit tests/*.test.mjs",
    "lint:skills": "node scripts/validate-skills.mjs",
    "lint:adapters": "node scripts/validate-adapters.mjs",
    "validate": "npm test && npm run lint:syntax && npm run lint:json && npm run lint:docs && npm run lint:skills && npm run lint:adapters",
    "smoke": "node scripts/smoke.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "lint:syntax": "node scripts/validate-syntax.mjs",
    "lint:json": "node scripts/validate-json.mjs",
    "lint:docs": "node scripts/validate-doc-links.mjs",
    "release:evidence": "node scripts/release-verify.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "adapter:tck": "node scripts/run-adapter-tck.mjs",
    "release:archive-test": "node scripts/archive-acceptance.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:sign": "node scripts/sign-release.mjs",
    "generate:capabilities": "node scripts/generate-capability-catalog.mjs",
    "generate:knowledge": "node scripts/generate-knowledge-packs.mjs",
    "generate:providers": "node scripts/generate-local-providers.mjs",
    "federation:audit": "node scripts/audit-federation.mjs",
    "federation:eval": "node scripts/validate-federation-evals.mjs",
    "generate:v2": "node scripts/migrate-stable-skills-v2.mjs && node scripts/generate-l0-kernel-skills.mjs && node scripts/generate-local-providers.mjs && node scripts/compile-capability-graph-v2.mjs && node scripts/generate-schemas.mjs",
    "skills:v2:audit": "node scripts/audit-skill-intelligence.mjs",
    "skills:materialize-all-stable": "node scripts/audit-skill-intelligence.mjs",
    "router:benchmark": "node scripts/benchmark-router-v2.mjs",
    "context:benchmark": "node scripts/benchmark-context-v2.mjs",
    "generate:v06": "node scripts/migrate-stable-skills-v2.mjs && node scripts/generate-l0-kernel-skills.mjs && node scripts/generate-l1-kernel-skills.mjs && node scripts/generate-local-providers.mjs && node scripts/compile-capability-graph-v2.mjs && node scripts/generate-schemas.mjs",
    "v06:audit": "node scripts/audit-v06.mjs",
    "skills:certification-audit": "node scripts/audit-skill-certification.mjs",
    "test:mutation-critical": "node scripts/critical-mutation-check.mjs"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "mcp",
    "a2a",
    "chatgpt-app",
    "codex",
    "claude-code",
    "product-engineering",
    "tdd",
    "multi-agent",
    "skill-federation",
    "capability-graph",
    "mcp-registry",
    "sqlite-wal",
    "oidc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgeos/forge-os.git"
  },
  "bugs": {
    "url": "https://github.com/forgeos/forge-os/issues"
  },
  "homepage": "https://github.com/forgeos/forge-os#readme",
  "files": [
    "src",
    "skills",
    "schemas",
    "adapters",
    "evals",
    "tck",
    "docs",
    "assets",
    "scripts",
    "README*.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    ".mcp.json",
    ".claude-plugin",
    "capabilities",
    "knowledge",
    "providers",
    "config",
    "deploy",
    "Dockerfile",
    ".env.example",
    "skills-v2",
    "capabilities-v2",
    "packs",
    "examples",
    "benchmarks"
  ],
  "bin": {
    "forge": "src/cli/forge.mjs"
  }
}
