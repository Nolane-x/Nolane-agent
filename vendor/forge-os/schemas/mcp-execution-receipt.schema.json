{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/v0.4/mcp-execution-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "providerId",
    "providerDigest",
    "toolName",
    "readOnly",
    "tenantId",
    "principal",
    "inputSha256",
    "status",
    "startedAt",
    "completedAt",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "mcp-tool-execution"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "providerDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolName": {
      "type": "string"
    },
    "readOnly": {
      "type": "boolean"
    },
    "tenantId": {
      "type": "string"
    },
    "principal": {
      "type": "object"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
