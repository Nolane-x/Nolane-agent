{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/mcp-tool-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structuredContent",
    "content"
  ],
  "properties": {
    "structuredContent": {
      "type": "object",
      "additionalProperties": true
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": true,
        "properties": {
          "type": {
            "enum": [
              "text",
              "image",
              "audio",
              "resource",
              "resource_link"
            ]
          }
        }
      }
    },
    "isError": {
      "type": "boolean"
    },
    "_meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
