              "type",
              "roles",
              "trustDomain"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@/-]{0,159}$"
              },
              "type": {
                "enum": [
                  "human",
                  "agent",
                  "service",
                  "system"
