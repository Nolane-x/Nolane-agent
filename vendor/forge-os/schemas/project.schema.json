                  "minLength": 1
                },
                "uniqueItems": true
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "trustDomain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
