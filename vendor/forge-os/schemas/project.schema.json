        "additionalProperties": true,
        "properties": {
          "ideaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "ideaSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
