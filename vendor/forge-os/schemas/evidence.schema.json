{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "summary",
    "sha256",
    "subject",
    "producer",
    "method",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,99}$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "unverified"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 10000
    },
    "uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,99}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "semanticRevision": {
          "type": "integer",
          "minimum": 1
        },
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "findingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "skillRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "producer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "type",
        "roles",
        "trustDomain"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@/-]{0,159}$"
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "service",
            "system"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trustDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "requestedBy": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "type",
        "roles",
        "trustDomain"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@/-]{0,159}$"
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "service",
            "system"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trustDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "method": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "trusted": {
          "const": true
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1
        },
        "payloadSha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestSha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "claimsSha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestedBy": {
          "type": "object",
          "required": [
            "id",
            "type",
            "roles",
            "trustDomain"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@/-]{0,159}$"
            },
            "type": {
              "enum": [
                "human",
                "agent",
                "service",
                "system"
              ]
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "trustDomain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "issuedBy": {
          "type": "object",
          "required": [
            "id",
            "type",
            "roles",
            "trustDomain"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._@/-]{0,159}$"
            },
            "type": {
              "enum": [
                "human",
                "agent",
                "service",
                "system"
              ]
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "trustDomain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "completedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "receiptSha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  }
}
