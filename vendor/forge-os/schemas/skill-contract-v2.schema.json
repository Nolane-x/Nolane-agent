{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgeos.dev/schemas/skill-contract-v2.schema.json",
  "title":"ForgeOS Skill Contract v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","version","skillType","maturity","identity","relations","contract","procedure","verification","context","quality","policyProfiles"],
  "properties":{
    "schemaVersion":{"const":2},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "skillType":{"enum":["discipline","technique","pattern","reference","tool","evaluator","recipe"]},
    "maturity":{"enum":["experimental","candidate","validated","stable","certified","deprecated","quarantined"]},
    "identity":{"type":"object"},"relations":{"type":"object"},"contract":{"type":"object"},"procedure":{"type":"object"},"verification":{"type":"object"},"context":{"type":"object"},"quality":{"type":"object"},"policyProfiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
  }
}
