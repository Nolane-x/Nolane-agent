{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/v0.4/knowledge-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "title",
    "loadingPolicy",
    "topics",
    "capabilities",
    "sources",
    "qualityPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "title": {
      "type": "string"
    },
    "loadingPolicy": {
      "const": "references-only-progressive-disclosure"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "authority",
          "trust",
          "revision",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "authority": {
            "type": "string"
          },
          "trust": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "license": {
            "type": "object"
          }
        }
      }
    },
    "qualityPolicy": {
      "type": "object"
    }
  }
}
