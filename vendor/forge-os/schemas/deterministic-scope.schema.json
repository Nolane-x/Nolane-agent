{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/v0.5/deterministic-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "included",
    "excluded",
    "policy",
    "scopeSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "scopeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
