{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgeos.dev/schemas/policy-profile.schema.json",
  "type":"object","additionalProperties":false,
  "required":["id","version","category","rules"],
  "properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"category":{"enum":["artifact","review","evidence","context","execution","security"]},"rules":{"type":"array","minItems":1,"items":{"type":"object"}},"description":{"type":"string"}}
}
