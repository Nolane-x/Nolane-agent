{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/v0.5/skill-context-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "manifestSha256",
    "model",
    "sections",
    "tokens",
    "text",
    "omitted",
    "contextPackSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "skillId": {
      "type": "string"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "tokens",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "contextPackSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
